FROM rust:1-slim-bookworm AS chef

RUN apt-get update && apt-get install -y --no-install-recommends \
    clang \
    curl \
    ca-certificates \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

RUN rustup toolchain install nightly && \
    rustup default nightly && \
    rustup target add wasm32-unknown-unknown

RUN curl -L --proto '=https' --tlsv1.2 -sSf \
    https://raw.githubusercontent.com/cargo-bins/cargo-binstall/main/install-from-binstall-release.sh | bash && \
    cargo binstall topcoat-cli cargo-chef wild-linker -y && \
    ln -s /usr/local/cargo/bin/wild /usr/local/cargo/bin/ld.wild && \
    curl https://rustwasm.github.io/wasm-pack/installer/init.sh -sSf | sh

WORKDIR /app

FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder
COPY --from=planner /app/recipe.json recipe.json

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    RUSTFLAGS="-Zshare-generics=y -Zthreads=0 --cfg getrandom_backend=\"wasm_js\"" \
    cargo chef cook --release --target wasm32-unknown-unknown --package game-client --recipe-path recipe.json

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    RUSTFLAGS="-C target-cpu=x86-64-v3 -C linker=clang -C link-arg=-fuse-ld=wild -Zshare-generics=y -Zthreads=0" \
    cargo chef cook --release --package personal-page --recipe-path recipe.json

COPY . .

ENV RUSTFLAGS="-Zshare-generics=y -Zthreads=0 --cfg getrandom_backend=\"wasm_js\""
RUN cd crates/game/client && wasm-pack build --target web --out-dir ../../../assets/game/pkg --release

ENV ASSETS_DIR="/app/assets"
ENV RUSTFLAGS="-C target-cpu=x86-64-v3 -C linker=clang -C link-arg=-fuse-ld=wild -Zshare-generics=y -Zthreads=0"
RUN mkdir -p /app/target/assets /app/dist && \
    cp -r /app/assets/* /app/target/assets/ 2>/dev/null || true && \
    topcoat asset bundle -p personal-page --release && \
    cp -r /app/assets/* /app/target/assets/ 2>/dev/null || true && \
    cp /app/target/release/personal-page /app/dist/personal-page && \
    cp -r /app/target/assets /app/dist/assets

FROM debian:bookworm-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /app/dist/personal-page /app/personal-page
COPY --from=builder /app/dist/assets /app/assets

ENV ASSETS_DIR="/app/assets"
ENV HOST="0.0.0.0"
ENV PORT="3000"
ENV RUST_LOG="info"
ENV RUST_BACKTRACE="1"

EXPOSE 3000

CMD ["/app/personal-page"]
